# ─────────────────────────────────────────────────────────────────────────
# Phase 1 / Phase 2 environment template.
#
# SECURITY NOTE (SDAD §4.1): In Production these values MUST come from
# AWS Secrets Manager or HashiCorp Vault — a plaintext .env is for LOCAL
# DEVELOPMENT ONLY. Never commit a populated .env.
# ─────────────────────────────────────────────────────────────────────────

# --- Tier 2: Google Custom Search Engine (ESG report discovery) ---
GOOGLE_API_KEY=
GOOGLE_CX_ID=

# --- Redis (rate limit, quota guard, search cache, circuit breaker) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Monitoring (§5) ---
SLACK_ALERT_WEBHOOK=

# --- Storage ---
LOCAL_STORAGE_ROOT=./data
STATIC_FALLBACK_ROOT=./data/static_fallback
CHECKPOINT_DB=./data/checkpoint.db
S3_BUCKET=
AWS_REGION=ap-southeast-1
